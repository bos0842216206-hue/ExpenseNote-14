<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_bg"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_blue"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_wallet"
                app:tint="@color/white"
                android:layout_marginBottom="12dp"
                android:contentDescription="@string/icon_wallet_desc" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="บันทึกค่าใช้จ่ายประจำวัน"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จดทุกบาทที่ใช้วันนี้ให้ครบเลยนะ"
                android:textSize="14sp"
                android:textColor="#F0F9FF" />
        </LinearLayout>

        <!-- Main Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_blue"
            android:orientation="vertical"
            android:padding="20dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <!-- Amount Input Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="โปรดใส่จำนวนเงิน (เป็นบาท)"
                android:textColor="@color/text_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etAmount"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edit_text_blue"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="numberDecimal"
                android:hint="เช่น 100 หรือ 10.25"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_sub"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- Note Input Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คำอธิบาย"
                android:textColor="@color/text_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_edit_text_blue"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:hint="เช่น ข้าวกลางวัน, ค่าเดินทาง"
                android:textColor="@color/text_title"
                android:textColorHint="@color/text_sub"
                android:textSize="15sp"
                android:layout_marginBottom="20dp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button
                    android:id="@+id/btnClear"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_clear_blue"
                    android:gravity="center"
                    android:text="เคลียร์"
                    android:textColor="@color/blue_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btnAdd"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_add_blue"
                    android:gravity="center"
                    android:text="เพิ่มรายการ"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Summary Result Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_result_box"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvLastItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="รายการล่าสุด: -"
                android:textColor="@color/text_sub"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/blue_border"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยอดรวมวันนี้: 0.00 บาท"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/blue_primary_dark" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
